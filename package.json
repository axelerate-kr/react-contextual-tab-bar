{
  "name": "react-contextual-tab-bar",
  "version": "0.1.0",
  "description": "A bottom tab bar whose items swap to a contextual sub-set with a back affordance — the Toss-style nested navigation pattern. Zero runtime dependencies.",
  "keywords": [
    "react",
    "tab-bar",
    "tabbar",
    "bottom-navigation",
    "bottom-tab-bar",
    "navigation",
    "contextual-navigation",
    "nested-tabs",
    "sub-tabs",
    "drilldown",
    "animation",
    "mobile",
    "pwa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelerate-kr/react-contextual-tab-bar.git"
  },
  "homepage": "https://axelerate-kr.github.io/react-contextual-tab-bar/",
  "bugs": {
    "url": "https://github.com/axelerate-kr/react-contextual-tab-bar/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
